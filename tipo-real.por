programa {
  funcao inicio() {
    real preco = 25.90
    real mediaNotas = 8.75
    real pesoPacote = 1.350

    escreva(" O preço informado do produto é de R$", preco, " com desconto.")
    escreva("\n Um aluno considerado mediano no seu desevolvimento academico, deve ter no minimo ", mediaNotas, " de media em sua grade escolar. ")
    escreva("\n Fui ao mercado, e passei no açougue, e comprei ", pesoPacote, " gramas de carne.")
  }
}
