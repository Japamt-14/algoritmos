programa {
  funcao inicio() {
    cadeia nome
    inteiro pontos, idade

    nome = "Douglas"
    pontos = 1500
    idade = 16
    escreva("Olá, mundo ! \n")
    escreva("Douglas tem ", idade, " de idade.\n")
    escreva(nome, " com ", idade, " anos de idade, garantiu muitas conquistas na sua carreira como jogador de basquete, efetuando mais de ", pontos, " pontos. \n" )

  }
}
