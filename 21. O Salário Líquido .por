programa {
  funcao inicio() {
    real salario, inss, salarioLiquido

      escreva("Digite seu salario em R$")
      leia(salario)

      escreva("Digite o valor do desconto do inss em R$: ")
      leia(inss)

      salarioLiquido = salario - inss
      escreva("Salario liquido= ", salarioLiquido)
      
  }
  }
}
